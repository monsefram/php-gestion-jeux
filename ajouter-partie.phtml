<?php
require_once "config.php";
require_once "session.php";
require_once "dal/dao/UtilisateurDao.php";
require_once "dal/dao/JeuDao.php";
require_once "dal/dao/PartieDao.php";

require_once "session.php";

$utilisateur = getUtilisateurConnecte();

if (!$utilisateur) {
    header("Location: connexion.phtml");
    exit;
}

if (!$utilisateur || $utilisateur->getRole()->getNom() !== "Administrateur")
{
    header("Location: index.phtml");
    exit;
}

$utilisateurDao = new UtilisateurDao($config);
$jeuDao = new JeuDao($config);
$partieDao = new PartieDao($config);

$joueurs = $utilisateurDao->selectAllParRole(2); // 2 = rôle "Joueur"
$jeux = $jeuDao->selectAll();

$erreurs = [];
$succes = false;

if ($_SERVER["REQUEST_METHOD"] === "POST")
{
    $j1 = intval($_POST["joueur1"]);
    $j2 = intval($_POST["joueur2"]);
    $s1 = intval($_POST["score1"]);
    $s2 = intval($_POST["score2"]);
    $jeu = intval($_POST["jeu"]);

    if ($j1 === $j2)
    {
        $erreurs[] = "Les deux joueurs doivent être différents.";
    }

    if ($s1 < 0 || $s2 < 0)
    {
        $erreurs[] = "Les scores doivent être ≥ 0.";
    }

    if (!$jeu || !$j1 || !$j2)
    {
        $erreurs[] = "Tous les champs sont obligatoires.";
    }

    if (empty($erreurs))
    {
        $partie = new Partie(
            new DateTime(),
            $j1,
            $j2,
            $s1,
            $s2,
            $jeu
        );



        $partieDao->insert($partie);
        $succes = true;
    }
}
?>

<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>Ajouter une partie</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/css/nouveau-style.css" rel="stylesheet">
</head>

<body>
    <?php require_once "section/entete.phtml"; ?>

    <div class="container py-5">
        <h1 class="mb-4">Ajouter une partie</h1>

        <?php foreach ($erreurs as $e): ?>
            <div class="alert alert-danger"><?= $e ?></div>
        <?php endforeach; ?>

        <?php if ($succes): ?>
            <div class="alert alert-success">✅ Partie ajoutée avec succès.</div>
        <?php endif; ?>

        <form method="post" class="row g-3">
            <div class="col-md-6">
                <label for="joueur1" class="form-label">Joueur 1</label>
                <select name="joueur1" id="joueur1" class="form-select" required>
                    <option value="">Choisir...</option>
                    <?php foreach ($joueurs as $j): ?>
                        <option value="<?= $j->getId() ?>"><?= htmlspecialchars($j->getNomUtilisateur()) ?></option>
                    <?php endforeach; ?>
                </select>
            </div>
            <div class="col-md-6">
                <label for="score1" class="form-label">Score joueur 1</label>
                <input type="number" min="0" name="score1" id="score1" class="form-control" required>
            </div>

            <div class="col-md-6">
                <label for="joueur2" class="form-label">Joueur 2</label>
                <select name="joueur2" id="joueur2" class="form-select" required>
                    <option value="">Choisir...</option>
                    <?php foreach ($joueurs as $j): ?>
                        <option value="<?= $j->getId() ?>"><?= htmlspecialchars($j->getNomUtilisateur()) ?></option>
                    <?php endforeach; ?>
                </select>
            </div>
            <div class="col-md-6">
                <label for="score2" class="form-label">Score joueur 2</label>
                <input type="number" min="0" name="score2" id="score2" class="form-control" required>
            </div>

            <div class="col-12">
                <label for="jeu" class="form-label">Jeu</label>
                <select name="jeu" id="jeu" class="form-select" required>
                    <option value="">Choisir un jeu...</option>
                    <?php foreach ($jeux as $j): ?>
                        <option value="<?= $j->getId() ?>"><?= htmlspecialchars($j->getNom()) ?></option>
                    <?php endforeach; ?>
                </select>
            </div>

            <div class="col-12">
                <button class="btn btn-primary">Ajouter la partie</button>
            </div>
        </form>
    </div>

    <?php require_once "section/pied.phtml"; ?>
</body>

</html>