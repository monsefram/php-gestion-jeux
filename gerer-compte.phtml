<?php
require_once "config.php";
require_once "session.php";
require_once "dal/dao/UtilisateurDao.php";

if (!isset($_SESSION["utilisateur"])) {
    header("Location: connexion.phtml");
    exit;
}

require_once "session.php";

$utilisateur = getUtilisateurConnecte();

if (!$utilisateur) {
    header("Location: connexion.phtml");
    exit;
}
$dao = new UtilisateurDao($config);
$erreurs = [];
$message = "";

// Mise à jour des infos
if ($_SERVER["REQUEST_METHOD"] === "POST" && isset($_POST["update_infos"])) {
    $utilisateur->setPrenom(trim($_POST["prenom"]));
    $utilisateur->setNom(trim($_POST["nom"]));
    $utilisateur->setBio(trim($_POST["bio"]));
    $utilisateur->setUrlAvatar(trim($_POST["url_avatar"]));
    $dao->update($utilisateur);
    $_SESSION["utilisateur"] = $utilisateur;
    $message = "✅ Informations mises à jour.";
}

// Changement de mot de passe
if ($_SERVER["REQUEST_METHOD"] === "POST" && isset($_POST["update_password"])) {
    $motActuel = $_POST["mot_actuel"];
    $nouveau = $_POST["nouveau"];
    $confirm = $_POST["confirmation"];

    if (!password_verify($motActuel, $utilisateur->getHash())) {
        $erreurs[] = "Mot de passe actuel incorrect.";
    } elseif ($nouveau !== $confirm) {
        $erreurs[] = "Les mots de passe ne correspondent pas.";
    } else {
        $hash = password_hash($nouveau, PASSWORD_DEFAULT);
        $utilisateur->setHash($hash);
        $dao->update($utilisateur);
        $message = "🔐 Mot de passe mis à jour.";
    }
}
?>

