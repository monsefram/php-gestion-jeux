<?php
require_once "config.php";
require_once "session.php";
require_once "utils/nettoyage.php";

$retroaction = "";

if ($_SERVER["REQUEST_METHOD"] === "POST")
{
    $nom = nettoyer($_POST["nom_utilisateur"]);
    $motDePasse = $_POST["mot_de_passe"];

    $utilisateurDao = new UtilisateurDao($config);
    $utilisateur = $utilisateurDao->selectParNomUtilisateur($nom);

    if ($utilisateur && password_verify($motDePasse, $utilisateur->getHash()))
    {
        $_SESSION['utilisateur'] = $utilisateur;
        $_SESSION['derniereActivite'] = time();
        header("Location: index.phtml");
        exit;
    }
    else
    {
        $retroaction = "Nom d’utilisateur ou mot de passe invalide.";
    }
}
?>

